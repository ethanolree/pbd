{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pbd app",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "PORT": "3000"
      }
    }
  ]
}
